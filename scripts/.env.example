# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# ".env" já está no .gitignore — nunca sobe pro Git.

# UID da conta de teste dedicada no Dashboard (NUNCA uma conta de mentorada real).
SMOKE_TEST_UID=

# Mesmo valor cadastrado no secret SMOKE_TEST_TOKEN do Firebase.
# Gerar com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Salvar com: firebase functions:secrets:set SMOKE_TEST_TOKEN
SMOKE_TEST_TOKEN=
